# ─── LIBRA RP — Admin Recruitment System API ───
NODE_ENV=development

# Public origin of the Next.js frontend (used for CORS + CSRF origin checks)
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=5000

# MongoDB MUST be a replica set (transactions are used for exam state transitions).
# Local: `npm run dev:db`  or  `docker compose up mongo`
MONGODB_URI=mongodb://127.0.0.1:27017/libra_interviews?replicaSet=rs0

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_SECURE_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_SECURE_SECRET

LOG_LEVEL=info
# Express "trust proxy" setting: loopback | <hop count> | true | false
TRUST_PROXY=loopback
# Defaults to true in production
# COOKIE_SECURE=true

# Sessions
ADMIN_SESSION_IDLE_MINUTES=60
ADMIN_SESSION_ABSOLUTE_HOURS=12
CANDIDATE_SESSION_HOURS=4

# Examination policy
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=25
# What happens when heartbeats stop (browser closed / connection lost): EXPIRE | DISQUALIFY
HEARTBEAT_TIMEOUT_ACTION=EXPIRE
# Network grace after a question deadline during which a final save is still accepted
SUBMISSION_GRACE_MS=1500
RECONCILE_INTERVAL_MS=2000

CANDIDATE_CODE_PREFIX=LIBRA-ADMIN
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Optional comma-separated extra trusted origins (e.g. a second dev port)
# EXTRA_ORIGINS=http://localhost:3100

# Optional: DNS servers for Node if mongodb+srv lookups fail (querySrv ECONNREFUSED)
# DNS_SERVERS=1.1.1.1,8.8.8.8
