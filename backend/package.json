{
  "name": "libra-rp-interviews-backend",
  "version": "1.0.0",
  "private": true,
  "description": "LIBRA RP \u2014 Admin Recruitment System API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:db": "tsx src/scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap:admin": "tsx src/scripts/bootstrap-head-admin.ts",
    "bootstrap:admin:prod": "node dist/scripts/bootstrap-head-admin.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:admin-assistant": "tsx src/scripts/seed-admin-assistant.ts",
    "seed:admin-level2": "tsx src/scripts/seed-admin-level2.ts",
    "set-timers": "tsx src/scripts/set-timers.ts",
    "indexes:sync": "tsx src/scripts/sync-indexes.ts",
    "retention:erase": "tsx src/scripts/legal-erasure.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.5",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
