# Used by docker-compose.yml. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_SECURE_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_SECURE_SECRET

# Public URL users open in their browser
FRONTEND_URL=http://localhost:3000
WEB_PORT=3000
COOKIE_SECURE=true
LOG_LEVEL=info
# EXPIRE | DISQUALIFY — what happens when an exam browser stops sending heartbeats
HEARTBEAT_TIMEOUT_ACTION=EXPIRE
